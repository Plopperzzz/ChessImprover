backend/.venv/
backend/data/

# Engine binaries. The small Maia console-script wrappers at the top level of
# assets/Engines are tracked deliberately; whole engine releases dropped in as
# subfolders (Stockfish is ~40MB) are not -- install those on each machine.
assets/Engines/*/
__pycache__/
*.pyc
.DS_Store
node_modules/
*.tgz
# The React UI's build output. Built on each machine with `npm run build` in
# web/ -- the server falls back to the classic UI when it isn't there.
web/dist/
db/*
# Local test virtualenv (torch + maia3 for driving the real engine)
.venv/
